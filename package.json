{
  "name": "polyglot2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "playwright test",
    "e2e:setup": "tsx scripts/e2e-reset.ts",
    "e2e:server": "tsx scripts/e2e-server.ts",
    "sprites:build": "node scripts/build-sprites.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:verify": "drizzle-kit check",
    "db:seed": "tsx --env-file=.env.local db/seed/run.ts",
    "db:cleanup-idempotency": "tsx --env-file=.env.local db/seed/cleanup-idempotency.ts",
    "curriculum:import": "tsx --env-file=.env.local scripts/curriculum-import.ts",
    "curriculum:reset": "tsx --env-file=.env.local scripts/curriculum-reset.ts",
    "leech:backfill": "tsx --env-file=.env.local scripts/backfill-leech-counters.ts",
    "lexicon:import": "tsx --env-file=.env.local scripts/lexicon-import.ts",
    "lexicon:import-rla": "tsx --env-file=.env.local scripts/lexicon-import-rla.ts",
    "lambda:build": "node scripts/build-lambda.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/client-sqs": "^3.1131.0",
    "@aws-sdk/client-ssm": "^3.1131.0",
    "@aws-sdk/s3-request-presigner": "^3.1131.0",
    "@clerk/nextjs": "^7.8.3",
    "@neondatabase/serverless": "^1.1.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.2",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.33.0",
    "motion": "^13.1.1",
    "next": "16.3.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.36",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/aws-lambda": "^8.10.163",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.7",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  }
}
