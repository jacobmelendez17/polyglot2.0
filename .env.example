# Clerk (see lib/env.ts)
# Get these from https://dashboard.clerk.com — the "polyglot2" application.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# First-party sign-in/sign-up pages (app/(auth)/*). Clerk components and
# redirects use these instead of Clerk's hosted account portal.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Where to land after auth when there's no other redirect context (e.g. no
# `redirect_url` from proxy.ts's auth.protect()). /dashboard until onboarding
# exists — see progress-tracker.md Open Questions.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Lessons (see lib/env.ts)
# HMAC-SHA256 signing secret for the ephemeral lesson-state token (spec 07 §8).
# Rotating this invalidates every in-flight lesson — acceptable, since an
# invalidated lesson behaves exactly like an expired one (lessons are
# intentionally ephemeral). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LESSON_STATE_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# HMAC-SHA256 signing secret for the ephemeral review-session token (spec 09
# §6). A dedicated secret, not a reuse of LESSON_STATE_SECRET — rotating one
# should not invalidate the other's in-flight sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
REVIEW_STATE_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Database (spec 08 — see lib/env.ts, db/client.ts)
# A real Neon (or other real PostgreSQL) connection string. Required at
# runtime and by drizzle-kit (db:generate/db:migrate/db:verify/db:seed).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Real PostgreSQL integration tests (spec 08 §5, §42, spec 22 — `npm run
# test:integration`). Must point at a dedicated Neon branch (or a local
# PostgreSQL database) that is NOT the same database as DATABASE_URL — never
# set this in production, and never point it at a shared dev/prod branch.
# `db/test/db-safety-guard.ts` fails closed (refuses to run) if this is
# missing, equal to DATABASE_URL, or APP_ENV is production.
TEST_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Real PostgreSQL end-to-end tests (spec 22 — `npm run test:e2e`,
# `npm run e2e:setup`). A third, independent Neon branch: never the same as
# DATABASE_URL or TEST_DATABASE_URL. The E2E Next.js server binds its own
# DATABASE_URL to this value (see `npm run e2e:server`) so Playwright drives
# real routes/Server Actions against genuinely isolated data. Same
# fail-closed safety guard as TEST_DATABASE_URL above.
E2E_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Permanent, non-production Clerk development identities used by the
# Playwright critical E2E suite (spec 22) — never real personal accounts.
# Auth state is generated via @clerk/testing's `clerk.signIn({ page,
# emailAddress })`, which mints a session through CLERK_SECRET_KEY, so no
# password needs to be stored here.
E2E_LEARNER_EMAIL=e2e-learner@example.com
E2E_ADMIN_EMAIL=e2e-admin@example.com
# Clerk user ids for the same two identities (`clerk users create` prints
# these) — lets `npm run e2e:setup` provision their internal Polyglot user
# rows directly, without an extra Clerk API round trip on every reset.
E2E_LEARNER_CLERK_USER_ID=user_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
E2E_ADMIN_CLERK_USER_ID=user_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Base URL the Playwright suite drives (spec 22). Local dev default shown;
# CI/preview point this at the deployed preview URL instead of localhost, per
# spec 22's "E2E Future CI Model" — the test logic itself never changes.
E2E_BASE_URL=http://localhost:3100

# Lexicon / dictionary import (spec 12 — see
# domains/lexicon/lexicon-source-config.ts). All optional: the application
# boots and runs without them, and the import CLI falls back to the small
# committed fixtures under /data-sources so `npm run lexicon:import` works on
# a fresh clone.
#
# Source locations are configured server-side only. The Admin UI can never
# supply a path or a remote URL — spec 12's security rules make that a hard
# boundary, not a convention.
#
# Path to a Wiktextract/Kaikki JSONL extract. `.gz` is streamed and
# decompressed in place, so a compressed dump needs no manual expansion.
LEXICON_WIKTEXTRACT_PATH=data-sources/wiktextract/es-sample.jsonl
# Upstream release identifier, recorded on the lexical_imports row.
LEXICON_WIKTEXTRACT_VERSION=

# Directory holding the RLA-ES Hunspell resources (<region>.dic / <region>.aff,
# e.g. es_MX.dic).
LEXICON_RLA_DIR=data-sources/rla-es
LEXICON_RLA_VERSION=

# Internal Polyglot user id (users.id, not a Clerk id) to attribute
# DICTIONARY_IMPORT_COMPLETED audit events to. A CLI import has no signed-in
# actor; when this is unset, the lexical_imports row remains the durable
# operational record and no audit event is written. Deliberately not
# defaulted to a synthetic user — a fictional actor in the permanent audit
# trail is worse than an absent one.
LEXICON_IMPORT_ACTOR_USER_ID=

# Curriculum import storage (spec 19 — see providers/storage/index.ts).
# Optional: the application boots without it, and only the curriculum-import
# upload flow needs it. Created via `infra/terraform/environments/dev`
# (`terraform output import_bucket_name`).
IMPORT_BUCKET=
AWS_REGION=us-west-2

# Curriculum import commit queue (spec 19 §11/§14 — see providers/queue/index.ts).
# Optional, same reasoning as IMPORT_BUCKET above. `terraform output import_queue_url`.
IMPORT_QUEUE_URL=

# Environment identity (spec 23 — see lib/env.ts). Optional here: Vercel sets
# VERCEL_ENV automatically on every deployment (preview/production), and
# lib/env.ts falls back to "development" when neither is set, so local dev
# and every test/CI run never need this. Set explicitly only if you need to
# force a value locally.
# APP_ENV=development

# Vercel Cron authentication (spec 20/23 — see lib/env.ts,
# app/api/cron/finalize-account-deletions/route.ts). Optional: local/test
# environments have no reason to run the finalize job. Required in the real
# Vercel Production environment variables before vercel.json's cron schedule
# goes live — a random public request must not be able to trigger it.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CRON_SECRET=

# Structured logging (spec 24 — see lib/logging/, lib/env.ts). Optional:
# defaults to "debug" in development and "info" everywhere else. Uncomment to
# temporarily raise/lower verbosity in a deployed environment without a code
# change. RELEASE is not set here — it comes from Vercel's own
# VERCEL_GIT_COMMIT_SHA automatically and falls back to "local" outside Vercel.
# LOG_LEVEL=info

# Rate limiting (spec 08 — see providers/rate-limit). Optional: local dev and
# every automated test use a credential-free in-memory implementation
# instead (architecture.md's Rate Limiting section) — these are required
# only in the real Vercel Preview/Production environment variables, each
# pointing at its own isolated Upstash Redis database (spec 23 — preview and
# production must never share rate-limit state).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Product analytics and observability (spec 27 — see lib/telemetry-config.ts and
# the setup runbook, infra/telemetry/README.md).
#
# EVERYTHING BELOW IS OPTIONAL, SERVER-ONLY AND OFF BY DEFAULT. None of it is
# NEXT_PUBLIC_, so none of it can reach a browser bundle.
#
#   * A provider is off unless its switch is exactly "true". Off means zero
#     outgoing requests, and its other settings are not even read.
#   * A switch that is on but cannot run safely — a missing or malformed
#     setting, the $0 plan not confirmed, or a non-production APP_ENV without
#     TELEMETRY_ALLOW_NON_PRODUCTION — leaves that provider off and logs one
#     warning naming the settings (never their values). It never stops the app.
#   * Free plans only. Spec 27 forbids any paid plan, card or upgrade; the two
#     *_FREE_PLAN_CONFIRMED switches are you saying you checked. Read the
#     runbook before setting either.
#   * Set these in Vercel's Production environment only — leave Preview and
#     Development empty — and keep production credentials out of .env.local.
#   * Nothing reads them yet. Setting them changes nothing until the units that
#     add the PostHog adapter (27.3) and the OpenTelemetry exporters (27.5,
#     27.6) have shipped.
# ---------------------------------------------------------------------------

# PostHog product analytics (Free plan: 1,000,000 events a month, no card).
POSTHOG_ENABLED=false
# "true" only after you have checked, in PostHog's billing settings, that the
# organization is on the Free plan with no payment method and pay-as-you-go off.
POSTHOG_FREE_PLAN_CONFIRMED=false
# The project token, which starts "phc_". A personal API key ("phx_") or a
# secure key ("phs_") is private and is refused here.
POSTHOG_PROJECT_TOKEN=
# The ingestion host for your PostHog region, and nothing else is accepted:
# https://us.i.posthog.com or https://eu.i.posthog.com
POSTHOG_HOST=

# Grafana Cloud over OTLP (Free plan: 10k metric series, 50 GB logs, 50 GB
# traces, 14-day retention, no card). One switch per signal, so each can be
# turned off on its own well before a Free limit (spec 27 §3.3).
TELEMETRY_METRICS_ENABLED=false
TELEMETRY_TRACES_ENABLED=false
TELEMETRY_LOGS_ENABLED=false
# "true" only after you have checked that the Grafana Cloud stack is on the Free
# plan with no payment method and no Pro or trial-only dependency.
GRAFANA_FREE_PLAN_CONFIRMED=false
# The base OTLP URL from your stack's OpenTelemetry tile, with no /v1/... suffix:
# https://otlp-gateway-<region>.grafana.net/otlp
GRAFANA_OTLP_ENDPOINT=
# The numeric instance id from that same tile (the Basic-auth user name).
GRAFANA_OTLP_INSTANCE_ID=
# A Cloud Access Policy token ("glc_...") holding metrics:write, traces:write
# and logs:write and nothing more. Treat it as a secret; rotate it if exposed.
GRAFANA_OTLP_TOKEN=
# Head-sampling probability for ordinary requests, 0 to 1 (0 turns tracing to
# nothing). Critical-operation metrics are never sampled.
TELEMETRY_TRACE_SAMPLE_RATIO=0.05

# Development and preview send nothing unless this is "true" as well — so a
# Vercel variable set for "all environments" cannot switch on preview capture,
# and production's PostHog project never receives preview or test events.
# Leave it "false" except for a deliberate, short-lived verification.
TELEMETRY_ALLOW_NON_PRODUCTION=false
