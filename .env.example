# Clerk (see lib/env.ts)
# Get these from https://dashboard.clerk.com — the "polyglot2" application.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# First-party sign-in/sign-up pages (app/(auth)/*). Clerk components and
# redirects use these instead of Clerk's hosted account portal.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Where to land after auth when there's no other redirect context (e.g. no
# `redirect_url` from proxy.ts's auth.protect()). /dashboard until onboarding
# exists — see progress-tracker.md Open Questions.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Lessons (see lib/env.ts)
# HMAC-SHA256 signing secret for the ephemeral lesson-state token (spec 07 §8).
# Rotating this invalidates every in-flight lesson — acceptable, since an
# invalidated lesson behaves exactly like an expired one (lessons are
# intentionally ephemeral). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LESSON_STATE_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# HMAC-SHA256 signing secret for the ephemeral review-session token (spec 09
# §6). A dedicated secret, not a reuse of LESSON_STATE_SECRET — rotating one
# should not invalidate the other's in-flight sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
REVIEW_STATE_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Database (spec 08 — see lib/env.ts, db/client.ts)
# A real Neon (or other real PostgreSQL) connection string. Required at
# runtime and by drizzle-kit (db:generate/db:migrate/db:verify/db:seed).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Real PostgreSQL integration tests (spec 08 §5, §42 — `npm run
# test:integration`). May point at a dedicated Neon dev/test branch or a
# local PostgreSQL database; never set this in production. This repo
# currently points it at the same branch as DATABASE_URL — safe because
# every integration test runs inside a rolled-back transaction (see
# db/test/with-test-transaction.ts) — but keeping it a separate variable
# means that stays a config choice, not something load-bearing.
TEST_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Lexicon / dictionary import (spec 12 — see
# domains/lexicon/lexicon-source-config.ts). All optional: the application
# boots and runs without them, and the import CLI falls back to the small
# committed fixtures under /data-sources so `npm run lexicon:import` works on
# a fresh clone.
#
# Source locations are configured server-side only. The Admin UI can never
# supply a path or a remote URL — spec 12's security rules make that a hard
# boundary, not a convention.
#
# Path to a Wiktextract/Kaikki JSONL extract. `.gz` is streamed and
# decompressed in place, so a compressed dump needs no manual expansion.
LEXICON_WIKTEXTRACT_PATH=data-sources/wiktextract/es-sample.jsonl
# Upstream release identifier, recorded on the lexical_imports row.
LEXICON_WIKTEXTRACT_VERSION=

# Directory holding the RLA-ES Hunspell resources (<region>.dic / <region>.aff,
# e.g. es_MX.dic).
LEXICON_RLA_DIR=data-sources/rla-es
LEXICON_RLA_VERSION=

# Internal Polyglot user id (users.id, not a Clerk id) to attribute
# DICTIONARY_IMPORT_COMPLETED audit events to. A CLI import has no signed-in
# actor; when this is unset, the lexical_imports row remains the durable
# operational record and no audit event is written. Deliberately not
# defaulted to a synthetic user — a fictional actor in the permanent audit
# trail is worse than an absent one.
LEXICON_IMPORT_ACTOR_USER_ID=

# Curriculum import storage (spec 19 — see providers/storage/index.ts).
# Optional: the application boots without it, and only the curriculum-import
# upload flow needs it. Created via `infra/terraform/environments/dev`
# (`terraform output import_bucket_name`).
IMPORT_BUCKET=
AWS_REGION=us-west-2

# Curriculum import commit queue (spec 19 §11/§14 — see providers/queue/index.ts).
# Optional, same reasoning as IMPORT_BUCKET above. `terraform output import_queue_url`.
IMPORT_QUEUE_URL=
